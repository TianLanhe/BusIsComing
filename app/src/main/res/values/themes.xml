<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BusIsComing.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/bus_chip_selected</item>
        <item name="colorPrimaryVariant">@color/bus_chip_selected</item>
        <item name="colorOnPrimary">@color/bus_on_accent</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/bus_action_secondary</item>
        <item name="colorSecondaryVariant">@color/bus_action_secondary</item>
        <item name="colorOnSecondary">@color/bus_on_secondary</item>
        <item name="colorSurface">@color/bus_card_surface</item>
        <item name="colorOnSurface">@color/bus_text_primary</item>
        <item name="colorError">@color/bus_danger</item>
        <item name="colorOnError">@color/bus_on_danger</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bus_page_gradient_start</item>
        <item name="android:navigationBarColor">@color/bus_chip_selected</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.BusIsComing" parent="Theme.BusIsComing.Base" />

    <style name="StableShortText">
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">start</item>
    </style>

    <style name="StableShortText.Title">
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">start</item>
    </style>

    <style name="StableShortText.Label">
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="StableShortText.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="StableShortText.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="StableShortText.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SettingsGroupLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">start</item>
        <item name="android:textColor">@color/bus_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/result_card_background</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="SettingsRowText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/bus_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingsRowValueText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">start</item>
        <item name="android:textColor">@color/bus_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
