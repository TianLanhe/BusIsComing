<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BusIsComing" parent="Theme.BusIsComing.Base">
        <item name="android:statusBarColor">@color/bus_page_gradient_start</item>
        <item name="android:navigationBarColor">@color/bus_card_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="StableShortText">
        <item name="android:justificationMode">none</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">start</item>
    </style>

    <style name="StableShortText.Title">
        <item name="android:justificationMode">none</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">start</item>
    </style>

    <style name="StableShortText.Label">
        <item name="android:justificationMode">none</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="StableShortText.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:justificationMode">none</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="StableShortText.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:justificationMode">none</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="StableShortText.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:justificationMode">none</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SettingsGroupLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:justificationMode">none</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">start</item>
        <item name="android:textColor">@color/bus_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsRowText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:justificationMode">none</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/bus_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
