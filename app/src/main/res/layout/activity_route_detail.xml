<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/routeDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bus_surface">

    <com.google.android.gms.maps.MapView
        android:id="@+id/routeDetailMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/route_map_content_description"
        app:cameraTargetLat="22.3193"
        app:cameraTargetLng="114.1694"
        app:cameraZoom="10.5" />

    <TextView
        android:id="@+id/routeDetailMapError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@color/bus_card_surface"
        android:elevation="4dp"
        android:gravity="center"
        android:maxWidth="320dp"
        android:padding="16dp"
        android:text="@string/route_map_unavailable"
        android:textColor="@color/bus_text_primary"
        android:textSize="15sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/routeDetailFloatingBack"
        style="@style/Widget.MaterialComponents.Button.Icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/route_detail_navigate_up"
        android:elevation="6dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/bus_card_surface"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="@color/bus_text_primary" />

    <LinearLayout
        android:id="@+id/routeDetailMapControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/routeDetailLocation"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/route_map_current_location"
            android:elevation="5dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/bus_card_surface"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_location_outline"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/bus_text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/routeDetailOverview"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/route_map_overview"
            android:elevation="5dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/bus_card_surface"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_route_overview"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/bus_text_primary" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/routeDetailCsdiAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="56dp"
        android:clickable="true"
        android:contentDescription="@string/route_map_csdi_attribution_accessibility"
        android:elevation="4dp"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/bus_card_surface"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/bus_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lands_department_logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/route_map_csdi_attribution_line_one"
                    android:textColor="@color/bus_text_primary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/route_map_csdi_attribution_line_two"
                    android:textColor="@color/bus_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/routeDetailSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_fitToContents="false"
        app:behavior_hideable="false"
        app:behavior_peekHeight="240dp"
        app:cardBackgroundColor="@color/bus_surface"
        app:cardElevation="10dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:shapeAppearance="@style/ShapeAppearance.BusIsComing.RouteDetailSheet">

        <LinearLayout
            android:id="@+id/routeDetailSheetContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/routeDetailSheetMapError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bus_surface_variant"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:text="@string/route_map_unavailable"
                android:textColor="@color/bus_text_primary"
                android:textSize="14sp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/routeDetailSheetHandle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="@string/route_detail_sheet_handle_summary"
                android:focusable="true">

                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="@drawable/route_detail_sheet_handle" />
            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/routeDetailList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="0dp"
                android:paddingBottom="24dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
