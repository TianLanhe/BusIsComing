<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_page_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/searchAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:id="@+id/searchContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingTop="12dp"
            app:layout_scrollFlags="scroll">

            <LinearLayout
                android:id="@+id/searchInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search_subtitle"
                    android:textColor="@color/bus_text_secondary"
                    android:textSize="14sp" />

                <com.golink.busiscoming.ui.common.PlacePairEditorView
                    android:id="@+id/searchPlacePairEditor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/searchQueryButton"
                    style="@style/StableShortText.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/search_routes" />
            </LinearLayout>

            <com.golink.busiscoming.ui.main.SearchTripContextLayout
                android:id="@+id/searchTripContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/searchTripContextLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search_current_trip"
                    android:textColor="@color/bus_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/searchTripContextBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/searchTripRouteText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/bus_text_primary"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/searchTripActions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/searchEditButton"
                            style="@style/StableShortText.Button.Text"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/search_edit_trip"
                            android:minHeight="48dp"
                            android:minWidth="48dp"
                            android:padding="12dp"
                            android:text=""
                            app:icon="@drawable/ic_edit"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="24dp"
                            app:iconTint="@color/bus_chip_selected" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/searchSaveButton"
                            style="@style/StableShortText.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:minHeight="48dp"
                            android:minWidth="48dp"
                            android:singleLine="true"
                            android:text="@string/search_trip_save"
                            android:visibility="gone"
                            app:icon="@drawable/ic_bookmark_outline"
                            app:iconPadding="6dp"
                            app:iconSize="20dp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/bus_divider" />
            </com.golink.busiscoming.ui.main.SearchTripContextLayout>

            <include layout="@layout/view_auto_refresh_notice" />
        </LinearLayout>

        <com.golink.busiscoming.ui.common.RouteResultControlsView
            android:id="@+id/searchRouteResultControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/searchResultSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="6dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/searchSwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/searchResultList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:visibility="gone" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="6dp"
            layout="@layout/view_route_query_status_card" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchResultRefreshOverlay"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="4dp"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="yes"
            android:visibility="gone"
            app:cardBackgroundColor="@color/bus_card_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/bus_divider"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ProgressBar
                    android:id="@+id/searchResultRefreshProgress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:indeterminate="true" />

                <ImageView
                    android:id="@+id/searchResultRefreshSuccess"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/route_refresh_complete"
                    android:src="@drawable/ic_refresh_success"
                    android:visibility="gone"
                    app:tint="@color/bus_chip_selected" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
