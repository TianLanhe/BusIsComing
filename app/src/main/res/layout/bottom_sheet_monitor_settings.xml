<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/monitor_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bus_card_surface"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/monitor_settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/monitor_settings_title"
                style="@style/StableShortText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/monitor_title"
                android:textColor="@color/bus_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/monitor_walking_card"
                style="@style/Widget.BusIsComing.MonitorSettings.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/StableShortText.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/monitor_walk_section"
                        android:textColor="@color/bus_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/monitor_decrease_button"
                            style="@style/StableShortText.Button.Outlined"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:contentDescription="@string/monitor_walking_decrease"
                            android:padding="0dp"
                            android:text="−"
                            android:textSize="20sp"
                            app:cornerRadius="8dp" />

                        <TextView
                            android:id="@+id/monitor_walking_minutes"
                            style="@style/StableShortText.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="@color/bus_text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/monitor_increase_button"
                            style="@style/StableShortText.Button.Outlined"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:contentDescription="@string/monitor_walking_increase"
                            android:padding="0dp"
                            android:text="+"
                            android:textSize="20sp"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/monitor_estimate_source"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/bus_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/StableShortText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/monitor_speed_section"
                android:textColor="@color/bus_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/monitor_speed_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                style="@style/StableShortText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/monitor_scenario_section"
                android:textColor="@color/bus_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/monitor_scenario_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="false" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BusIsComing.MonitorSettings.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <LinearLayout
                        android:id="@+id/monitor_notification_status_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView
                                style="@style/StableShortText.Label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/monitor_preparation"
                                android:textColor="@color/bus_text_primary"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/monitor_notification_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/bus_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/monitor_notification_settings_button"
                            style="@style/StableShortText.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:contentDescription="@string/monitor_notification_settings_content_description"
                            android:text="@string/monitor_notification_settings"
                            android:textColor="@color/bus_chip_selected" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/bus_divider" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/monitor_voice_switch"
                        style="@style/StableShortText.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:checked="true"
                        android:gravity="center_vertical"
                        android:text="@string/monitor_voice"
                        android:textColor="@color/bus_text_primary"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bus_divider" />

    <LinearLayout
        android:id="@+id/monitor_action_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/monitor_start_button"
            style="@style/StableShortText.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/monitor_start" />
    </LinearLayout>
</LinearLayout>
