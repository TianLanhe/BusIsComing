<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/autoRefreshNotice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="4dp"
    android:accessibilityLiveRegion="polite"
    android:focusable="false"
    android:importantForAccessibility="yes"
    android:visibility="gone"
    app:cardBackgroundColor="@color/bus_auto_refresh_notice_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/bus_auto_refresh_notice_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/autoRefreshNoticeBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/autoRefreshNoticeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_refresh_notice_title"
                    android:textColor="@color/bus_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/autoRefreshNoticeMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/bus_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/autoRefreshNoticeSettings"
                style="@style/StableShortText.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="@string/auto_refresh_notice_settings"
                android:textColor="@color/bus_chip_selected" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/autoRefreshNoticeCountdown"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="1000"
            android:progress="1000"
            app:indicatorColor="@color/bus_auto_refresh_notice_border"
            app:trackColor="@android:color/transparent"
            app:trackCornerRadius="0dp"
            app:trackThickness="3dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
